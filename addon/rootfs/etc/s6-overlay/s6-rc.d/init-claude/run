#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Claude Code Add-on: Environment setup
# Sets up environment, CLAUDE.md, MCP config, persistent storage
# ==============================================================================
declare base_url=''
declare auth_token=''
declare model=''
declare disable_mouse
declare protect_internal_files

bashio::log.info 'Setting up Claude Code environment...'

# --- Read config ---
# Empty options export nothing, so Claude Code keeps its own defaults
if bashio::config.has_value 'anthropic_base_url'; then
    base_url=$(bashio::config 'anthropic_base_url')
fi
if bashio::config.has_value 'anthropic_auth_token'; then
    auth_token=$(bashio::config 'anthropic_auth_token')
fi
if bashio::config.has_value 'anthropic_model'; then
    model=$(bashio::config 'anthropic_model')
fi
disable_mouse=$(bashio::config 'disable_mouse')
# Off only when set to false on purpose; a missing value counts as on
protect_internal_files=true
if [[ "$(bashio::config 'protect_internal_files')" == "false" ]]; then
    protect_internal_files=false
fi

# --- Drop stored values of removed options ---
# The configuration form only shows options of the current schema, but Home
# Assistant keeps the saved values of removed ones (api_key until 0.1.x,
# enable_embeddings until 0.2.x, yolo_mode until 0.7.3, model until 0.11.x;
# visible in the YAML editor) until the configuration is saved again. Remove
# them once through the Supervisor API. A failure only logs a warning, it
# never stops the add-on.
#
# The selection model (default|sonnet|opus|haiku) became the free text option
# anthropic_model in 0.12.0. A stored sonnet, opus or haiku moves over;
# default leaves the new default (opus).
declare stored_options
declare migrated_model=''
declare removed_options='["api_key","enable_embeddings","yolo_mode","model"]'
if stored_options=$(curl -fsS -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
        http://supervisor/addons/self/info | jq -c '.data.options') &&
   jq -e --argjson removed "${removed_options}" \
        'any(keys[]; IN($removed[]))' <<< "${stored_options}" > /dev/null; then
    migrated_model=$(jq -r '.model // empty | select(IN("sonnet", "opus", "haiku"))' <<< "${stored_options}")
    if [[ -n "${migrated_model}" ]]; then
        # options.json of this start still holds the old value; use the new one now
        model="${migrated_model}"
        bashio::log.info "Moved the model '${migrated_model}' to the option anthropic_model."
    fi
    if jq -c --argjson removed "${removed_options}" --arg model "${migrated_model}" \
            '{options: (with_entries(select(.key | IN($removed[]) | not))
                        + (if $model != "" then {anthropic_model: $model} else {} end))}' <<< "${stored_options}" |
       curl -fsS -X POST -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
            -H 'Content-Type: application/json' --data @- \
            http://supervisor/addons/self/options > /dev/null; then
        bashio::log.info 'Removed the stored values of removed options (api_key, enable_embeddings, yolo_mode, model).'
    else
        bashio::log.warning 'Could not remove old options; saving the add-on configuration once removes them too.'
    fi
fi

# --- Set environment variables for all services (s6 convention: one file per var) ---
printf '%s' "/opt/mcp-server/data/docs-search.db" > /var/run/s6/container_environment/DOCS_DB_PATH
printf '%s' "/opt/docs" > /var/run/s6/container_environment/DOCS_PATH

# Write all config to /etc/profile.d/ so the entrypoint shell sees them
{
    echo "export SUPERVISOR_TOKEN=\"${SUPERVISOR_TOKEN}\""
    echo "export DISABLE_AUTOUPDATER=1"
    # Options anthropic_*: only set ones are exported. %q quotes the values
    # for the shell; the token is never logged.
    if [[ -n "${base_url}" ]]; then
        printf 'export ANTHROPIC_BASE_URL=%q\n' "${base_url}"
    fi
    if [[ -n "${auth_token}" ]]; then
        printf 'export ANTHROPIC_AUTH_TOKEN=%q\n' "${auth_token}"
    fi
    if [[ -n "${model}" ]]; then
        printf 'export ANTHROPIC_MODEL=%q\n' "${model}"
    fi
    # Keep the GitHub CLI login and the git config in /data across restarts
    echo "export GH_CONFIG_DIR=/data/.config/gh"
    echo "export GIT_CONFIG_GLOBAL=/data/.gitconfig"
    # Without mouse tracking the terminal does its own selection, which is the
    # only way to select and copy text with a finger on a phone
    if [[ "${disable_mouse}" == "true" ]]; then
        echo "export CLAUDE_CODE_DISABLE_MOUSE=1"
    fi
} > /etc/profile.d/claude.sh
if [[ -n "${base_url}" ]]; then
    bashio::log.info "API requests go to ${base_url} (anthropic_base_url)."
fi
if [[ -n "${auth_token}" ]]; then
    bashio::log.info 'Claude Code uses the token of the option anthropic_auth_token.'
else
    bashio::log.info 'Log in with Claude Code on first start; the login is kept across restarts.'
fi

# --- MQTT broker credentials (config.yaml: services: mqtt:want) ---
# The Supervisor provides them when the Mosquitto broker add-on is installed.
mqtt_available=false
if bashio::services.available 'mqtt'; then
    bashio::log.info 'MQTT broker found — providing its credentials as MQTT_* variables.'
    mqtt_available=true
    {
        printf 'export MQTT_HOST=%q\n' "$(bashio::services 'mqtt' 'host')"
        printf 'export MQTT_PORT=%q\n' "$(bashio::services 'mqtt' 'port')"
        printf 'export MQTT_USERNAME=%q\n' "$(bashio::services 'mqtt' 'username')"
        printf 'export MQTT_PASSWORD=%q\n' "$(bashio::services 'mqtt' 'password')"
    } >> /etc/profile.d/claude.sh
fi

# --- Persistent storage ---
mkdir -p /data/.claude /data/.config/gh
# Versions before 0.3.0 downloaded an embedding model for the removed
# semantic search here (about 87 MB); it is not used anymore.
if [[ -d /data/models ]]; then
    bashio::log.info 'Removing the unused embedding model from /data/models...'
    rm -rf /data/models
fi
touch /data/.bash_history /data/.gitconfig

# The Claude installer pre-creates /root/.claude as a real directory and writes
# /root/.claude.json during the image build. `ln -sf` onto an existing directory
# creates the link *inside* it (/root/.claude/.claude), so credentials, sessions
# and memory end up on the ephemeral container layer and are lost on every
# restart. Seed .claude.json from the installer's copy on first run, then
# replace the installer's directory with the symlink outright.
if [[ ! -f /data/.claude.json ]]; then
    if [[ -f /root/.claude.json && ! -L /root/.claude.json ]]; then
        cp /root/.claude.json /data/.claude.json
    else
        echo '{}' > /data/.claude.json
    fi
fi
if [[ -d /root/.claude && ! -L /root/.claude ]]; then
    rm -rf /root/.claude
fi

# Symlink persistent data into root home (-n: never descend into an existing link)
ln -sfn /data/.claude /root/.claude
ln -sfn /data/.claude.json /root/.claude.json
ln -sfn /data/.bash_history /root/.bash_history

# Symlink convenient paths
ln -sfn /homeassistant /root/homeassistant
ln -sfn /share /root/share

# --- Generate managed settings (system-wide) ---
mkdir -p /etc/claude-code

# Rewritten on every start, which also clears the allow list of the option
# yolo_mode (removed in 0.7.4). No allow rules and no default mode here: users
# pick the permission mode in Claude Code (Shift+Tab, /permissions).
#
# Option protect_internal_files: deny rules that keep Claude Code's file tools
# from changing Home Assistant's internal state. A broken .storage/ registry
# can keep Home Assistant from starting. Managed rules apply in every
# permission mode, including bypassPermissions, and the user's own settings
# cannot lift them. They also cover file commands Claude Code recognizes in
# Bash (cat, sed, tee, redirections), not scripts that open files themselves.
# `//` makes a rule path absolute: a single leading `/` would be relative to
# the settings file. Deny rules also match a path reached through a symlink
# such as /root/homeassistant. `home-assistant_v2.db*` covers the -wal and
# -shm files of the recorder database.
if [[ "${protect_internal_files}" == true ]]; then
    bashio::log.info "Home Assistant's internal files (.storage, .cloud, deps, tts, recorder database) are read-only for Claude Code."
    cat > /etc/claude-code/managed-settings.json << 'EOF'
{
  "permissions": {
    "deny": [
      "Edit(//homeassistant/.storage/**)",
      "Edit(//homeassistant/.cloud/**)",
      "Edit(//homeassistant/deps/**)",
      "Edit(//homeassistant/tts/**)",
      "Edit(//homeassistant/home-assistant_v2.db*)"
    ]
  }
}
EOF
else
    bashio::log.warning "protect_internal_files is off: Claude Code may change Home Assistant's internal files, including .storage."
    echo '{}' > /etc/claude-code/managed-settings.json
fi

# --- Generate managed MCP config (system-wide, always loaded) ---
bashio::log.info 'Generating MCP server configuration...'

cat > /etc/claude-code/managed-mcp.json << MCPEOF
{
  "mcpServers": {
    "home-assistant": {
      "command": "node",
      "args": ["/opt/mcp-server/dist/index.js"],
      "env": {
        "SUPERVISOR_TOKEN": "${SUPERVISOR_TOKEN}",
        "DOCS_DB_PATH": "/opt/mcp-server/data/docs-search.db",
        "DOCS_PATH": "/opt/docs"
      }
    }
  }
}
MCPEOF

# --- Generate the managed CLAUDE.md (system-wide, refreshed on every start) ---
# Claude Code always loads /etc/claude-code/CLAUDE.md, so every install gets
# the current description of the add-on, including existing ones whose
# /homeassistant/CLAUDE.md predates it.
bashio::log.info 'Generating CLAUDE.md for the add-on environment...'
{
    cat << 'EOF'
# Home Assistant add-on environment

You are running inside the Claude Code add-on of a Home Assistant instance. The add-on writes this file on every start; it describes what is available here. The user's own notes for you are in `/homeassistant/CLAUDE.md`.

## Container

- Alpine Linux, you run as `root`. The working directory is `/homeassistant`.
- Claude Code runs in the tmux session `claude` behind the Claude Code panel in the Home Assistant sidebar.
- Only these locations survive an add-on restart or update:
  - `/data`: Claude Code login, history and memory, GitHub CLI login (`GH_CONFIG_DIR`), global git config (`GIT_CONFIG_GLOBAL`)
  - The mapped folders under [Files](#files)
- Everything else is lost, for example packages installed with `apk add` or files in `/tmp`. For packages the user needs permanently, ask them to add the package to the add-on option **Additional packages**.

## Files

- `/homeassistant/`: Home Assistant configuration (`configuration.yaml`, `automations.yaml`, `scripts.yaml`, `secrets.yaml`, ...), including `.storage/`. Read/write.
- `/config/`: this add-on's own configuration folder. Read/write.
- `/share/`: storage shared between add-ons. Read/write.
- `/ssl/`: certificates. Read-only.
- `/media/`: media files. Read-only.
- `/opt/docs/`: Home Assistant user and developer docs as markdown. Search them with the `search_docs` tool.

Rules for working on the configuration:

- Copy a file before larger edits, for example to `<file>.bak`.
EOF
    if [[ "${protect_internal_files}" == true ]]; then
        cat << 'EOF'
- `.storage/`, `.cloud/`, `deps/`, `tts/` and the recorder database `home-assistant_v2.db` under `/homeassistant/` belong to Home Assistant. The add-on option **Protect internal files** makes them read-only for you (managed permission rules). Do not work around it with scripts, `cp`, `mv` or `sqlite3`. Change what is stored there through the MCP tools, the APIs or the Home Assistant UI. If none of them can do it, tell the user; only they can turn the option off.
EOF
    else
        cat << 'EOF'
- Do not edit files in `/homeassistant/.storage/` while Home Assistant is running, unless the user explicitly asks. Home Assistant keeps them in memory and overwrites them. Use the MCP tools or the APIs instead.
EOF
    fi
    cat << 'EOF'
- After changing YAML configuration, run the config check (see below) before reloading.
- Prefer reloading (for example the service `automation.reload`) over restarting. Never restart Home Assistant, the host or an add-on without asking the user.
- Never print secrets from `secrets.yaml` or tokens in full.

## MCP tools (server `home-assistant`)

- `search_entities`: search entities by name, domain or area
- `get_entity_state`: state and attributes of an entity
- `call_service`: call a service (turns on real devices: ask first when unsure)
- `search_automations`: search automations
- `get_ha_config`: core configuration
- `list_areas`: all areas
- `search_devices`: device registry
- `get_config_entries`: integration config entries
- `search_docs`, `read_doc`, `get_doc_stats`: the bundled Home Assistant docs

## Home Assistant APIs

`$SUPERVISOR_TOKEN` is set and authorizes both APIs below (send it as `Authorization: Bearer $SUPERVISOR_TOKEN`).

- Core REST API at `http://supervisor/core/api/`, for example:
  - State: `curl -s -H "Authorization: Bearer $SUPERVISOR_TOKEN" http://supervisor/core/api/states/sun.sun`
  - Config check: `curl -s -X POST -H "Authorization: Bearer $SUPERVISOR_TOKEN" http://supervisor/core/api/config/core/check_config`
  - Render a template: `POST /core/api/template` with `{"template": "{{ states('sun.sun') }}"}`
  - The Core endpoint `/core/api/error_log` returns 404 on Home Assistant OS (Core writes no `home-assistant.log` there). Read the log through the Supervisor API instead: `curl -s -H "Authorization: Bearer $SUPERVISOR_TOKEN" -H "Accept: text/plain" "http://supervisor/core/logs?lines=500"` (`/core/logs/latest`: since the last start of Home Assistant)
- Supervisor API at `http://supervisor/` (this add-on has the admin role), for example `GET /core/info`, `GET /core/logs`, `GET /addons`, `GET /addons/<slug>/logs`. Actions such as `POST /core/restart` need the user's consent first.

## Command line tools

- `python3` with PyYAML. Home Assistant YAML uses custom tags (`!include`, `!secret`, `!input`, `!env_var`, ...), which `yaml.safe_load` rejects. To read such files, keep the tags as text:

  ```python
  import yaml

  class HALoader(yaml.SafeLoader):
      pass

  def ha_tag(loader, suffix, node):
      return f"!{suffix} {loader.construct_scalar(node)}"

  HALoader.add_multi_constructor("!", ha_tag)
  data = yaml.load(open("/homeassistant/configuration.yaml"), Loader=HALoader)
  ```

  This only checks the YAML syntax. Whether Home Assistant accepts the configuration is shown by the config check above.
- `gh` (GitHub CLI): not logged in by default. The user can log in with `gh auth login` (device code in the browser); the login is kept in `/data`. `gh auth setup-git` makes `git push` over HTTPS use it.
- `mosquitto_pub` and `mosquitto_sub`: MQTT clients, see [MQTT](#mqtt).
- `git`, `jq`, `curl`, `rg` (ripgrep), `node`, `bash`, `tmux`.

## MQTT

EOF
    if [[ "${mqtt_available}" == true ]]; then
        cat << 'EOF'
The MQTT broker of this Home Assistant (Mosquitto broker add-on) is available. Its connection details are in the environment variables `MQTT_HOST`, `MQTT_PORT`, `MQTT_USERNAME` and `MQTT_PASSWORD`. Use the variables, never write the password into files or print it.

- Always limit subscriptions so they end, with `-W <seconds>` or `-C <count>`, for example: `mosquitto_sub -h "$MQTT_HOST" -p "$MQTT_PORT" -u "$MQTT_USERNAME" -P "$MQTT_PASSWORD" -t 'homeassistant/#' -v -W 10`
EOF
    else
        cat << 'EOF'
Home Assistant provides no MQTT broker credentials: the Mosquitto broker add-on is not installed. If the user has another broker, ask for host, port, username and password, and do not store them in files.

- Always limit subscriptions so they end, with `-W <seconds>` or `-C <count>`, for example: `mosquitto_sub -h <host> -u <user> -P <password> -t 'homeassistant/#' -v -W 10`
EOF
    fi
    cat << 'EOF'
- Publishing can switch real devices. Ask before publishing to command topics, and never publish retained messages (`-r`) to discovery topics without being asked.
EOF
    printf '\n## Add-on settings\n\n'
    printf -- '- Model (`ANTHROPIC_MODEL`): `%s`\n' "${model:-Claude Code default}"
    printf -- '- API (`ANTHROPIC_BASE_URL`): `%s`\n' "${base_url:-Anthropic API}"
    printf -- '- Protect internal files: `%s`\n' "${protect_internal_files}"
} > /etc/claude-code/CLAUDE.md

# --- /homeassistant/CLAUDE.md is for the user's own notes ---
# Only created when missing; an existing file is never touched.
if [[ ! -f /homeassistant/CLAUDE.md ]]; then
    bashio::log.info 'Creating /homeassistant/CLAUDE.md for your own notes...'
    cat > /homeassistant/CLAUDE.md << 'EOF'
# Notes for Claude Code

The add-on describes its environment, tools and APIs in `/etc/claude-code/CLAUDE.md`. Claude Code loads that file automatically, and the add-on refreshes it on every start.

Add your own notes for Claude here, for example which integrations matter to you or conventions for your configuration.
EOF
fi

bashio::log.info 'Claude Code environment ready.'
