#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Claude Code Add-on: Install additional packages
# ==============================================================================

if bashio::config.has_value 'additional_packages'; then
    bashio::log.info 'Installing additional packages...'

    # Right after a host start or during a short outage the network may not
    # be up yet (the Tailscale add-on waits for it, too). Fetching the package
    # indexes is the first thing that needs it: retry after 20 s and 2 min,
    # like the Docker build does.
    for wait in 20 120 0; do
        apk update && break
        [[ "${wait}" -eq 0 ]] && bashio::exit.nok 'Failed updating Alpine package indexes'
        bashio::log.warning "Updating the Alpine package indexes failed, retrying in ${wait} s..."
        sleep "${wait}"
    done

    for package in $(bashio::config 'additional_packages'); do
        apk add --no-cache "$package" \
            || bashio::exit.nok "Failed installing package: ${package}"
    done

    bashio::log.info 'Additional packages installed.'
fi
