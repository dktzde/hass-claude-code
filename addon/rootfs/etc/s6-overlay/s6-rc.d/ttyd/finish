#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Claude Code Add-on: ttyd finish script
# Takes down the supervision tree when ttyd exits unexpectedly
# (same handling as the Tailscale add-on of the Home Assistant Community Apps)
# ==============================================================================
exit_code_container=$(</run/s6-linux-init-container-results/exitcode)
readonly exit_code_container
readonly exit_code_service="${1}"
readonly exit_code_signal="${2}"
readonly service="${3:-ttyd}"

bashio::log.info \
  "Service ${service} exited with code ${exit_code_service}" \
  "(by signal ${exit_code_signal})"

if [[ "${exit_code_service}" -eq 256 ]]; then
  # Killed by a signal. SIGTERM is a normal stop of the add-on: no error code,
  # so Home Assistant does not show the add-on as failed after a manual stop.
  if [[ "${exit_code_signal}" -ne 15 && "${exit_code_container}" -eq 0 ]]; then
    echo "$((128 + exit_code_signal))" > /run/s6-linux-init-container-results/exitcode
  fi
  [[ "${exit_code_signal}" -eq 15 ]] && exec /run/s6/basedir/bin/halt
elif [[ "${exit_code_service}" -ne 0 ]]; then
  if [[ "${exit_code_container}" -eq 0 ]]; then
    echo "${exit_code_service}" > /run/s6-linux-init-container-results/exitcode
  fi
  # While s6 is still starting the services, halt does not stop the container
  # (s6-overlay 3.2 restarts the service forever instead). Exit code 125 marks
  # the service as permanently failed, so s6 does not restart it; the oneshot
  # s6-has-started, which writes /run/s6_has_started, then finds ttyd down and
  # fails the start, which stops the container.
  if ! bashio::fs.file_exists /run/s6_has_started; then
    exit 125
  fi
  exec /run/s6/basedir/bin/halt
fi
